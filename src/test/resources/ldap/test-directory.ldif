# Shaped after test/seed-mock-data.sh: common names with spaces, the manager link carried as
# user.title -> manager.street, and groupOfUniqueNames under ou=Groups. "Doe\, Jane" adds an escaped
# comma, the one DN shape naive string handling gets wrong.

dn: dc=winllc,dc=com
objectClass: domain
dc: winllc

dn: ou=Users,dc=winllc,dc=com
objectClass: organizationalUnit
ou: Users

dn: ou=Groups,dc=winllc,dc=com
objectClass: organizationalUnit
ou: Groups

dn: ou=Companies,dc=winllc,dc=com
objectClass: organizationalUnit
ou: Companies

