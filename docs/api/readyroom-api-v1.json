{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Read-only access to ReadyRoom for HR, payroll and workforce systems: the people ReadyRoom tracks and their status, attendance records, and absences and leave.\n\nEvery call needs an API token (Authorization: Bearer ensapi_...). An administrator creates it under Administration, Integrations, chooses its scopes, expiry and rate limit, and sees it once. A token reads what that administrator may read at the time of the call, and never more. Past its rate limit a call gets 429 with Retry-After. Times are ISO-8601 with an offset, in each person's time zone.\n\nSigned webhooks for absence alerts and status changes are described in the README (Public API and webhooks).",
    "title" : "ReadyRoom API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "https://readyroom.example.com",
    "description" : "This ReadyRoom"
  } ],
  "security" : [ {
    "apiToken" : [ ]
  } ],
  "tags" : [ {
    "description" : "Attendance records by date range",
    "name" : "Attendance"
  }, {
    "description" : "Absences, leave and leave requests",
    "name" : "Absences"
  }, {
    "description" : "Tracked people and their status today",
    "name" : "People"
  } ],
  "paths" : {
    "/api/v1/absences" : {
      "get" : {
        "description" : "Each day from the first to the last (both included) that has a status other than a standard working day on the calendar of someone whose details the token's owner may see: approved leave and telework, statuses people set, and absences managers recorded. Needs the absences:read scope.",
        "operationId" : "absences",
        "parameters" : [ {
          "description" : "First day, YYYY-MM-DD",
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "description" : "Last day, YYYY-MM-DD, included",
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "description" : "Only this person (DN)",
          "in" : "query",
          "name" : "dn",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Page, from 1",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          }
        }, {
          "description" : "Items a page",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 100
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageApiAbsence"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "A parameter is missing or wrong"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "No token, or a malformed, unknown, revoked or expired one"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The token lacks the scope, its owner may not see that person, or the feature is not licensed"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Over the token's rate limit; see Retry-After"
          }
        },
        "summary" : "Absence and leave days by date range",
        "tags" : [ "Absences" ]
      }
    },
    "/api/v1/absences/requests" : {
      "get" : {
        "description" : "Requests for leave, telework and other statuses that cover any day from the first to the last, of people whose details the token's owner may see, with their decision. Notes and comments are left out. Needs the absences:read scope.",
