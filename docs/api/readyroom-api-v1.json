        "parameters" : [ {
          "description" : "First day, YYYY-MM-DD",
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "description" : "Last day, YYYY-MM-DD, included",
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "description" : "Only this person (DN)",
          "in" : "query",
          "name" : "dn",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only requests in this state: REQUESTED, APPROVED, REJECTED or CANCELLED",
          "in" : "query",
          "name" : "state",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Page, from 1",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          }
        }, {
          "description" : "Items a page",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 100
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageApiLeaveRequest"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "A parameter is missing or wrong"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "No token, or a malformed, unknown, revoked or expired one"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The token lacks the scope, its owner may not see that person, or the feature is not licensed"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Over the token's rate limit; see Retry-After"
          }
        },
        "summary" : "Leave requests covering a date range",
        "tags" : [ "Absences" ]
      }
    },
