      "ApiPerson" : {
        "type" : "object",
        "description" : "A tracked person and their status today. Times are present only for people whose details the token's owner may see; for others the status is what a coworker sees (privacy settings), possibly null.",
        "properties" : {
          "checkedInAt" : {
            "type" : "string",
            "format" : "date-time",
