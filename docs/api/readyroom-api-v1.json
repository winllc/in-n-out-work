  "components" : {
    "schemas" : {
      "ApiAbsence" : {
        "type" : "object",
        "description" : "A day on someone's calendar with a status other than a standard working day",
        "properties" : {
          "date" : {
            "type" : "string",
            "format" : "date",
            "example" : "2026-10-23"
          },
          "dn" : {
            "type" : "string",
            "example" : "CN=Jane Doe,OU=Users,DC=example,DC=com"
          },
          "loginByTime" : {
            "type" : "string",
            "description" : "For LATE_ARRIVAL: the expected arrival time",
            "example" : "10:30"
          },
          "name" : {
            "type" : "string",
            "example" : "Jane Doe"
          },
          "requestId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The approved request it comes from, for source request",
            "example" : 4512
          },
          "source" : {
            "type" : "string",
            "description" : "request: an approved leave request; self: set by the person; manager: recorded by a manager in answer to an absence alert",
            "example" : "request"
          },
          "status" : {
            "type" : "string",
            "description" : "OUT_OF_OFFICE, WORK_FROM_HOME, TDY, SCHEDULED_LEAVE, UNSCHEDULED_LEAVE, ABSENT_EXCUSED, ABSENT_UNEXCUSED, ABSENT, EARLY_LEAVE or LATE_ARRIVAL",
            "example" : "SCHEDULED_LEAVE"
          },
          "statusName" : {
            "type" : "string",
            "example" : "Scheduled leave"
          }
        }
      },
      "ApiAttendanceEvent" : {
        "type" : "object",
        "description" : "One attendance event from the Windows client, or an automatic check-out",
        "properties" : {
          "action" : {
            "type" : "string",
            "description" : "CHECK_IN, LOCK, UNLOCK or CHECK_OUT",
            "example" : "CHECK_IN"
          },
          "date" : {
            "type" : "string",
            "format" : "date",
            "description" : "The day it counts towards, in the person's time zone",
            "example" : "2026-10-21"
          },
          "dn" : {
            "type" : "string",
            "example" : "CN=Jane Doe,OU=Users,DC=example,DC=com"
          },
          "forced" : {
            "type" : "boolean",
            "description" : "A check-out made automatically after a long lock",
            "example" : false
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Stable id",
            "example" : 918273
          },
          "name" : {
            "type" : "string",
            "example" : "Jane Doe"
          },
          "timeZone" : {
            "type" : "string",
            "example" : "America/New_York"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When (ISO-8601, in the person's time zone)",
            "example" : "2026-10-21T08:02:11-04:00"
          }
        }
      },
      "ApiError" : {
        "description" : "An error: a stable code and a sentence for people.",
        "properties" : {
          "error" : {
            "type" : "string",
            "description" : "A stable code: unauthorized, forbidden, rate_limited, bad_request, not_licensed, ...",
            "example" : "bad_request"
          },
          "message" : {
            "type" : "string",
            "description" : "What went wrong, for people",
            "example" : "from must be on or before to"
          }
        }
      },
      "ApiLeaveRequest" : {
        "type" : "object",
        "description" : "A request for a status over a range of days, and its decision",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "decidedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "decidedBy" : {
            "type" : "string",
            "description" : "Who approved or rejected it"
          },
          "dn" : {
            "type" : "string",
            "example" : "CN=Jane Doe,OU=Users,DC=example,DC=com"
          },
          "fromDate" : {
            "type" : "string",
            "format" : "date",
            "example" : "2026-10-23"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 4512
          },
          "name" : {
            "type" : "string",
            "example" : "Jane Doe"
          },
          "state" : {
            "type" : "string",
            "description" : "REQUESTED, APPROVED, REJECTED or CANCELLED",
            "example" : "APPROVED"
          },
          "status" : {
            "type" : "string",
            "example" : "SCHEDULED_LEAVE"
          },
          "statusName" : {
            "type" : "string",
            "example" : "Scheduled leave"
          },
          "toDate" : {
            "type" : "string",
            "format" : "date",
            "description" : "The last day, included",
            "example" : "2026-10-24"
          }
        }
      },
      "ApiPageApiAbsence" : {
        "type" : "object",
        "description" : "One page of results. Pages count from 1.",
        "properties" : {
          "items" : {
            "type" : "array",
            "description" : "This page's items",
            "items" : {
