{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ReadyRoom chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "More than 1 needs the license state out of the pods' ReadWriteOnce volume."
    },
    "strategy": {
      "type": "object",
      "description": "Empty: RollingUpdate, or Recreate while the license is on a ReadWriteOnce volume."
    },
    "revisionHistoryLimit": {
      "type": "integer"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "openshift": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "javaOpts": {
      "type": "string"
    },
    "publicUrl": {
      "type": "string"
    },
    "bannerText": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "checkOutAfterMinutes": {
      "type": "integer"
    },
    "updateProfileUrl": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "logFormat": {
      "type": "string",
      "enum": [
        "json",
        "text"
      ]
    },
    "csp": {
      "type": "object",
      "properties": {
        "reportOnly": {
          "type": "boolean"
        }
      }
    },
    "consentBanner": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "existingConfigMapKey": {
          "type": "string"
        }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "idleTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h|d))?$"
        },
        "adminIdleTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h|d))?$"
        },
        "absoluteTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h|d))?$"
        },
        "maxPerUser": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "maxRangeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3660
        },
        "requestStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OUT_OF_OFFICE",
              "WORK_FROM_HOME",
              "TDY",
              "SCHEDULED_LEAVE",
              "UNSCHEDULED_LEAVE",
              "ABSENT_EXCUSED",
              "ABSENT_UNEXCUSED",
              "ABSENT",
              "EARLY_LEAVE",
              "LATE_ARRIVAL"
            ]
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "properties": {
        "coworkerVisibility": {
          "type": "string",
          "enum": [
            "full",
            "status",
            "none"
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "eventsDays": {
          "type": "integer",
          "minimum": 0,
          "not": {
            "minimum": 1,
            "maximum": 30
          }
        },
        "schedule": {
          "type": "string",
          "minLength": 11
        }
      }
    },
    "reports": {
      "type": "object",
      "properties": {
        "siteTimeZones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^=]+=[A-Za-z0-9_+\\-/]+$"
          }
        },
        "maxRangeDays": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttachmentBytes": {
          "type": "integer",
          "minimum": 10000
        },
        "maxRecipients": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "maxTokenDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3660
        },
        "defaultRatePerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "maxRatePerMinute": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "webhooks": {
      "type": "object",
      "properties": {
        "secretKey": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "anyOf": [
                {
                  "maxLength": 0
                },
                {
                  "minLength": 32
                }
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "allowedCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "superUserDns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "embedded": {
          "type": "object",
