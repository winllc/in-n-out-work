# ReadyRoom - site configuration.
#
# install.sh copies this file to .env (once; it never overwrites an existing .env) and fills in a random
# database password. Edit every value marked CHANGE_ME, then run ./install.sh again to start.
#
# Format: KEY=value, one per line, no spaces around "=". Quotes are not needed for spaces or commas.
# A value containing "$" must be wrapped in single quotes ('pa$$word'), or Docker Compose expands it.
#
# Every line here reaches the application as an environment variable, so any other setting from the
# ReadyRoom documentation can be added the same way: the property name upper-cased, dots and dashes
# dropped or turned into underscores (application.check-out-after-minutes -> APPLICATION_CHECKOUTAFTERMINUTES,
# list entries numbered: APPLICATION_SUPERUSERDNS_0, APPLICATION_SUPERUSERDNS_1, ...).
#
# Keep .env private (install.sh makes it mode 600): it holds the database, directory and mail passwords.

# ---------------------------------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------------------------------

# Optional pieces. Uncomment one line to add TLS with your own keystore and/or Windows sign-in; see
# docker-compose.tls.yml and docker-compose.windows-auth.yml for the files each one needs.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.windows-auth.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml:docker-compose.windows-auth.yml

# Host port and address ReadyRoom is published on. The container always listens on 8181; do not set
# SERVER_PORT.
READYROOM_PORT=8181
READYROOM_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------------------------------

# The URL users reach ReadyRoom at; notification e-mails link to it. https:// when SSL_ENABLED=true or
# when a reverse proxy terminates TLS in front of it.
APPLICATION_BASE_URL=https://CHANGE_ME.example.com:8181

# ---------------------------------------------------------------------------------------------------
# Database (the bundled PostgreSQL 16 container)
# ---------------------------------------------------------------------------------------------------

# These create the database on first start and are what the application signs in with. Changing them
# later does not change an existing database; change the password in PostgreSQL first.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=readyroom
DB_USERNAME=readyroom
DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------------------------------
# Directory (your LDAP server or Active Directory)
# ---------------------------------------------------------------------------------------------------

# Host and port of the directory; ReadyRoom connects with ldap://LDAP_HOST:LDAP_PORT.
LDAP_HOST=CHANGE_ME.example.com
LDAP_PORT=389
# For LDAPS instead, set the whole URL, which takes precedence over LDAP_HOST/LDAP_PORT. The directory's
# certificate must then be trusted by the JVM (a publicly trusted certificate is).
#SPRING_LDAP_URLS=ldaps://ldap.example.com:636

# A read-only service account ReadyRoom searches the directory with (bind DN, or user@domain for AD).
LDAP_USERNAME=CN=CHANGE_ME,OU=Service Accounts,DC=example,DC=com
LDAP_PASSWORD=CHANGE_ME

# Where users are, and which entries are users.
APPLICATION_USERBASEDN=DC=CHANGE_ME,DC=com
#APPLICATION_USERLDAPFILTER=(objectclass=inetOrgPerson)
# Active Directory, for example:
#APPLICATION_USERLDAPFILTER=(&(objectCategory=person)(objectClass=user))

# Top-level group trees shown in the UI, one numbered entry each.
APPLICATION_GROUPS_0_GROUPSBASEDN=OU=Groups,DC=CHANGE_ME,DC=com
#APPLICATION_GROUPS_1_GROUPSBASEDN=OU=Departments,DC=example,DC=com

# Users always treated as administrators (full DNs), one numbered entry each. At least one, or nobody
# can administer ReadyRoom.
APPLICATION_SUPERUSERDNS_0=CN=CHANGE_ME,OU=Users,DC=example,DC=com
#APPLICATION_SUPERUSERDNS_1=CN=Second Admin,OU=Users,DC=example,DC=com

# Org chart: the group tree it is built from. Leave empty to turn the org chart off.
APPLICATION_DUTYSUBORGGROUPSBASEDN=

# Directory attributes ReadyRoom reads (defaults shown in the documentation). Uncomment to change.
#APPLICATION_USERLDAPORGANIZATIONATTRIBUTE=o
#APPLICATION_USERLDAPLOCATIONATTRIBUTE=l
#APPLICATION_USERLDAPEMPLOYEETYPEATTRIBUTE=employeeType
#APPLICATION_USERLDAPMANAGERIDATTRIBUTE=title
#APPLICATION_MANAGERLDAPIDATTRIBUTE=street
#APPLICATION_USERLDAPDUTYSUBORGANIZATIONATTRIBUTE=departmentNumber

# ---------------------------------------------------------------------------------------------------
# Mail (absence notifications)
# ---------------------------------------------------------------------------------------------------

# Your SMTP server. The packaged configuration points at a development host, so set these.
SPRING_MAIL_HOST=CHANGE_ME.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
# SMTP AUTH and STARTTLS are on by default. For a relay that takes neither:
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
# The packaged configuration trusts any certificate the mail server presents ("*"). To trust only
# certificates valid for your mail host instead, name it:
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=smtp.example.com

# The From address of notification e-mails.
APPLICATION_NOTIFICATIONSENDEREMAIL=readyroom@CHANGE_ME.example.com

# The health check (/actuator/health, and so "docker compose ps") includes the mail server: while it
# cannot be reached ReadyRoom reports DOWN and the container shows as unhealthy, although everything
# but e-mail keeps working. Set false if you do not use mail, or do not want a mail outage to mark
# ReadyRoom unhealthy.
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# ---------------------------------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------------------------------

# Off: plain HTTP on 8181. Client-certificate (X.509) sign-in, and therefore the Windows client's
# check-in, lock and unlock calls, needs TLS: set true, add docker-compose.tls.yml to COMPOSE_FILE
# above and put your keystore in ./tls. Leave false when a reverse proxy terminates TLS for browsers
# only.
SSL_ENABLED=false
#SERVER_SSL_KEYSTOREPASSWORD=
#SERVER_SSL_TRUSTSTOREPASSWORD=
# want: ask browsers for a certificate but fall back to the password form (the default).
#SERVER_SSL_CLIENTAUTH=want

# ---------------------------------------------------------------------------------------------------
# Windows (Kerberos) sign-in - optional, needs TLS and docker-compose.windows-auth.yml
# ---------------------------------------------------------------------------------------------------

#APPLICATION_WINDOWSAUTH_ENABLED=true
#APPLICATION_WINDOWSAUTH_SERVICEPRINCIPAL=HTTP/readyroom.example.com@EXAMPLE.COM
# The directory attribute holding the Windows account name: sAMAccountName (default), or
# userPrincipalName together with APPLICATION_WINDOWSAUTH_STRIPREALM=false.
#APPLICATION_WINDOWSAUTH_ACCOUNTATTRIBUTE=sAMAccountName

# ---------------------------------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------------------------------

# Banner shown at the top of every page, and the time zone dates are shown in.
APPLICATION_BANNERTEXT=ReadyRoom
SPRING_JACKSON_TIMEZONE=America/New_York
# Minutes of inactivity before an open session is checked out automatically.
APPLICATION_CHECKOUTAFTERMINUTES=240
# Where the "update my profile" link sends users (your directory's self-service page).
#APPLICATION_UPDATEPROFILEURL=https://selfservice.example.com/

# JVM options. The default uses up to 75% of the container's memory limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# Application log level: info, or debug when diagnosing a problem.
LOGGING_LEVEL_COM_WINLLC_INNOUTWORK=info
