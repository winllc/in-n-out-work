# ReadyRoom - site configuration.
#
# install.sh copies this file to .env (once; it never overwrites an existing .env) and fills in a random
# database password. Edit every value marked CHANGE_ME, then run ./install.sh again to start.
#
# Format: KEY=value, one per line, no spaces around "=". Quotes are not needed for spaces or commas.
# A value containing "$" must be wrapped in single quotes ('pa$$word'), or Docker Compose expands it.
#
# Every line here reaches the application as an environment variable, so any other setting from the
# ReadyRoom documentation can be added the same way: the property name upper-cased, dots and dashes
# dropped or turned into underscores (application.check-out-after-minutes -> APPLICATION_CHECKOUTAFTERMINUTES,
# list entries numbered: APPLICATION_SUPERUSERDNS_0, APPLICATION_SUPERUSERDNS_1, ...).
#
# Keep .env private (install.sh makes it mode 600): it holds the database, directory and mail passwords.

# ---------------------------------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------------------------------

# Optional pieces. Uncomment one line to add TLS with your own keystore and/or Windows sign-in; see
# docker-compose.tls.yml and docker-compose.windows-auth.yml for the files each one needs.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.windows-auth.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml:docker-compose.windows-auth.yml

# Host port and address ReadyRoom is published on. The container always listens on 8181; do not set
# SERVER_PORT.
READYROOM_PORT=8181
READYROOM_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------------------------------

# The URL users reach ReadyRoom at; notification e-mails link to it. https:// when SSL_ENABLED=true or
# when a reverse proxy terminates TLS in front of it.
APPLICATION_BASE_URL=https://CHANGE_ME.example.com:8181

# ---------------------------------------------------------------------------------------------------
# Database (the bundled PostgreSQL 16 container)
# ---------------------------------------------------------------------------------------------------

# These create the database on first start and are what the application signs in with. Changing them
# later does not change an existing database; change the password in PostgreSQL first.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=readyroom
DB_USERNAME=readyroom
DB_PASSWORD=CHANGE_ME
# ReadyRoom migrates its schema itself at startup (Flyway). For a database of your own rather than the
# bundled one, a separate account can own and migrate the schema so DB_USERNAME only reads and writes rows;
# see "Database migrations" in the documentation for the grants. Unset: DB_USERNAME migrates.
#SPRING_FLYWAY_USER=readyroom_owner
#SPRING_FLYWAY_PASSWORD=

# ---------------------------------------------------------------------------------------------------
# Directory (your LDAP server or Active Directory)
# ---------------------------------------------------------------------------------------------------

# The directory's URL. ldaps:// (port 636) encrypts the connection, and with it the passwords the sign-in
# form checks against the directory; the directory's certificate must be trusted by the JVM (a publicly
# trusted certificate is). Several, comma-separated, for failover.
SPRING_LDAP_URLS=ldaps://CHANGE_ME.example.com:636
# Plain ldap:// instead, NOT RECOMMENDED: passwords cross the network in clear text, and ReadyRoom warns at
# startup. Remove SPRING_LDAP_URLS above and set these; ReadyRoom then connects to ldap://LDAP_HOST:LDAP_PORT.
#LDAP_HOST=ldap.example.com
#LDAP_PORT=389

# A read-only service account ReadyRoom searches the directory with (bind DN, or user@domain for AD).
LDAP_USERNAME=CN=CHANGE_ME,OU=Service Accounts,DC=example,DC=com
LDAP_PASSWORD=CHANGE_ME

# Where users are, and which entries are users.
APPLICATION_USERBASEDN=DC=CHANGE_ME,DC=com
#APPLICATION_USERLDAPFILTER=(objectclass=inetOrgPerson)
# Active Directory, for example:
#APPLICATION_USERLDAPFILTER=(&(objectCategory=person)(objectClass=user))

# Top-level group trees shown in the UI, one numbered entry each.
APPLICATION_GROUPS_0_GROUPSBASEDN=OU=Groups,DC=CHANGE_ME,DC=com
#APPLICATION_GROUPS_1_GROUPSBASEDN=OU=Departments,DC=example,DC=com

# Users always treated as administrators (full DNs), one numbered entry each. At least one, or nobody
# can administer ReadyRoom.
APPLICATION_SUPERUSERDNS_0=CN=CHANGE_ME,OU=Users,DC=example,DC=com
#APPLICATION_SUPERUSERDNS_1=CN=Second Admin,OU=Users,DC=example,DC=com

# Org chart: the group tree it is built from. Leave empty to turn the org chart off.
APPLICATION_DUTYSUBORGGROUPSBASEDN=

# Directory attributes ReadyRoom reads (defaults shown in the documentation). Uncomment to change.
#APPLICATION_USERLDAPORGANIZATIONATTRIBUTE=o
#APPLICATION_USERLDAPLOCATIONATTRIBUTE=l
#APPLICATION_USERLDAPEMPLOYEETYPEATTRIBUTE=employeeType
#APPLICATION_USERLDAPMANAGERIDATTRIBUTE=title
#APPLICATION_MANAGERLDAPIDATTRIBUTE=street
#APPLICATION_USERLDAPDUTYSUBORGANIZATIONATTRIBUTE=departmentNumber

# ---------------------------------------------------------------------------------------------------
# Mail (absence notifications)
# ---------------------------------------------------------------------------------------------------

# Your SMTP server. None is packaged: without SPRING_MAIL_HOST absence alerts are recorded but not
# e-mailed, and with it APPLICATION_NOTIFICATIONSENDEREMAIL below is required. A server that stops
# answering times out after 30 seconds.
SPRING_MAIL_HOST=CHANGE_ME.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
# SMTP AUTH and STARTTLS are on by default, and with STARTTLS on nothing is sent unless the server offers
# it. For a relay that takes neither:
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
# The mail server's certificate is checked against the JVM's trust store. Earlier releases trusted any
# certificate; to trust your mail host's certificate without checking it (an explicit opt-in, not
# FIPS- or STIG-appropriate), name it, or * for any:
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=smtp.example.com

# The From address of notification e-mails.
APPLICATION_NOTIFICATIONSENDEREMAIL=readyroom@CHANGE_ME.example.com

# The health check (/actuator/health, and so "docker compose ps") includes the mail server: while it
# cannot be reached ReadyRoom reports DOWN and the container shows as unhealthy, although everything
# but e-mail keeps working. Set false if you do not use mail, or do not want a mail outage to mark
# ReadyRoom unhealthy.
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# ---------------------------------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------------------------------

# Off: plain HTTP on 8181. Client-certificate (X.509) sign-in, and therefore the Windows client's
# check-in, lock and unlock calls, needs TLS: set true, add docker-compose.tls.yml to COMPOSE_FILE
# above, put your keystore and truststore in ./tls (tls/keystore.p12, tls/truststore.p12) and set both
# passwords below. Leave false when a reverse proxy terminates TLS for browsers only.
#
# Both stores are required with TLS on: the image contains none, and ReadyRoom refuses to start rather
# than fall back to one. The truststore must hold only the CAs that issue your users' client
# certificates: any certificate one of them issues with a user's DN signs in as that user.
SSL_ENABLED=false
#SERVER_SSL_KEYSTOREPASSWORD=
#SERVER_SSL_TRUSTSTOREPASSWORD=
# want: ask browsers for a certificate but fall back to the password form (the default).
#SERVER_SSL_CLIENTAUTH=want
# The session cookie is marked Secure when SSL_ENABLED=true. Set this when a reverse proxy terminates TLS
# for browsers instead, so the cookie is still only ever sent over HTTPS (SESSION_COOKIE_SECURE, the older
# name, still works).
#ENS_COOKIE_SECURE=true
# Behind a reverse proxy that terminates TLS, read its X-Forwarded-Proto, -Host and -For headers, so
# ReadyRoom knows requests are HTTPS (Strict-Transport-Security, redirects) and logs the client's address.
# Only when every request comes through that proxy: the headers are believed as sent.
#SERVER_FORWARD_HEADERS_STRATEGY=framework
# Send the Content-Security-Policy as Report-Only (reported, not enforced): an escape hatch for a page the
# policy breaks. Default false.
#ENS_CSP_REPORT_ONLY=false

# ---------------------------------------------------------------------------------------------------
# Notice-and-consent banner and session lifetime
# ---------------------------------------------------------------------------------------------------

# The DoD notice-and-consent banner before any sign-in, enforced by the server. Off by default. The text
# defaults to the standard DoD text; ENS_CONSENT_BANNER_FILE (a file mounted into the container) wins
# over ENS_CONSENT_BANNER_TEXT.
#ENS_CONSENT_BANNER_ENABLED=true
#ENS_CONSENT_BANNER_TITLE=U.S. Government (USG) Information System (IS) Notice and Consent
#ENS_CONSENT_BANNER_TEXT=
#ENS_CONSENT_BANNER_FILE=

# Browser sessions end after this long idle, this long after sign-in, and past this many per user (the
# oldest ends; 0 is no limit). STIG suggests ENS_SESSION_ADMIN_IDLE_TIMEOUT=15m and ENS_SESSION_MAX_PER_USER=3.
#ENS_SESSION_IDLE_TIMEOUT=30m
#ENS_SESSION_ADMIN_IDLE_TIMEOUT=30m
#ENS_SESSION_ABSOLUTE_TIMEOUT=12h
#ENS_SESSION_MAX_PER_USER=0

# ---------------------------------------------------------------------------------------------------
# Status requests, privacy and retention - see "Statuses and approvals" and "Privacy and retention"
# ---------------------------------------------------------------------------------------------------

# The statuses people ask for and their manager (or a delegate, or an administrator) approves before
# they count, comma-separated. Default: every status that excuses an absence.
#APPLICATION_EVENTS_REQUESTSTATUSES=OUT_OF_OFFICE,WORK_FROM_HOME,TDY,SCHEDULED_LEAVE,ABSENT_EXCUSED
# The most days one call may set a status or request on. Default 366.
#APPLICATION_EVENTS_MAXRANGEDAYS=366

# What people see of coworkers whose details they may not see: full (default; presence and the day's
# status), status (in or out only) or none.
#APPLICATION_PRIVACY_COWORKERVISIBILITY=full

# Days to keep check-in records, statuses, status requests and absence alerts; older ones are summarised
# by month and deleted. 0 (the default) keeps them forever; otherwise at least 31. Audit events keep
# their own retention (ENS_AUDIT_RETENTION_DAYS below).
#APPLICATION_RETENTION_EVENTSDAYS=0
# When the purge runs: a six-field Spring cron (second minute hour day month weekday). Default 02:17 daily.
#APPLICATION_RETENTION_CRON=0 17 2 * * *

# ---------------------------------------------------------------------------------------------------
# Public API and webhooks - see "Public API and webhooks" in the documentation
# ---------------------------------------------------------------------------------------------------

# Webhooks (signed posts for absence alerts and status changes) stay off until this is set: the key their
# signing secrets are encrypted with, 32 characters or more (e.g. openssl rand -base64 36). Keep it: if it
# changes, existing webhooks must be created again.
#APPLICATION_WEBHOOKS_SECRETKEY=
# Private or loopback ranges webhooks may still be sent to, comma separated (e.g. 10.20.0.0/16). Default: none.
#APPLICATION_WEBHOOKS_ALLOWEDCIDRS=
# The longest an API token may be valid, in days, and the most requests a minute one may be given.
#APPLICATION_API_MAXTOKENDAYS=366
#APPLICATION_API_MAXRATEPERMINUTE=1200

# ---------------------------------------------------------------------------------------------------
# Client certificates (CAC/PIV) - see "Client certificates" in the documentation
# ---------------------------------------------------------------------------------------------------

# Find the user by an LDAP filter on the certificate instead of its subject DN: {upn}, {edipi}, {email},
# {uuid}, {subject}, {cn}. For Active Directory and CAC, for example:
#ENS_X509_USER_FILTER=(userPrincipalName={upn})
# Only certificates from these issuers sign in (DNs separated by ;).
#ENS_X509_ALLOWED_ISSUERS=CN=DOD ID CA-59,OU=PKI,OU=DoD,O=U.S. Government,C=US;CN=DOD ID CA-62,OU=PKI,OU=DoD,O=U.S. Government,C=US
# Revocation checking: off (default), ocsp, crl or ocsp-then-crl. STIG requires it.
#ENS_X509_REVOCATION=ocsp-then-crl
#ENS_X509_OCSP_RESPONDER_URL=
# A directory of CRL files mounted into the container (air-gapped); CRLs are then never fetched.
#ENS_X509_CRL_DIR=/etc/in-n-out/crl
# closed (default) refuses a certificate whose status is unknown; open allows it with a warning.
#ENS_X509_REVOCATION_FAIL=closed
#ENS_X509_REVOCATION_CACHE=10m
# Behind a reverse proxy that terminates TLS and forwards the client certificate in a header, with a shared
# secret of 32+ characters in X-ENS-Proxy-Secret. Needs the CAs of your users' certificates as PEM.
#ENS_X509_SOURCE=header
#ENS_X509_HEADER=X-SSL-Client-Cert
#ENS_X509_TRUSTED_PROXIES=172.16.0.0/12
#ENS_X509_PROXY_SECRET_FILE=/etc/in-n-out/x509/proxy-secret
#ENS_X509_TRUSTED_CA_FILE=/etc/in-n-out/x509/ca.pem

# ---------------------------------------------------------------------------------------------------
# Windows (Kerberos) sign-in - optional, needs TLS and docker-compose.windows-auth.yml
# ---------------------------------------------------------------------------------------------------

#APPLICATION_WINDOWSAUTH_ENABLED=true
#APPLICATION_WINDOWSAUTH_SERVICEPRINCIPAL=HTTP/readyroom.example.com@EXAMPLE.COM
# The directory attribute holding the Windows account name: sAMAccountName (default), or
# userPrincipalName together with APPLICATION_WINDOWSAUTH_STRIPREALM=false.
#APPLICATION_WINDOWSAUTH_ACCOUNTATTRIBUTE=sAMAccountName

# ---------------------------------------------------------------------------------------------------
# Audit logging (ens-audit/1) - see "Audit logging" in README.md
# ---------------------------------------------------------------------------------------------------

# The audit trail is always stored in the database and shown under Administration > Audit log. These
# add outputs for a SIEM such as Splunk. Leave a line commented for its default.

# Each event as one JSON line on the container's stdout ("docker compose logs app", Docker logging
# drivers, the Splunk Universal Forwarder). Default true.
#ENS_AUDIT_STDOUT=true

# Also write the lines to a file, rotated daily or at 100 MB. The ens-audit volume is mounted at
# /var/log/ens for this. Off when empty.
#ENS_AUDIT_FILE=/var/log/ens/readyroom/audit.jsonl
# Rotated files kept. Default 30.
#ENS_AUDIT_FILE_KEEP=30

# Days to keep audit events in the database; 0 (the default) keeps them forever. Events are pruned only
# once every enabled output below has delivered them.
#ENS_AUDIT_RETENTION_DAYS=0

# Splunk HTTP Event Collector. Off when ENS_AUDIT_SPLUNK_URL is empty.
#ENS_AUDIT_SPLUNK_URL=https://splunk.example.com:8088
# The HEC token, or a file holding it (mount it read-only; keeps it out of .env).
#ENS_AUDIT_SPLUNK_TOKEN=
#ENS_AUDIT_SPLUNK_TOKEN_FILE=
# Optional index; the sourcetype defaults to ens:audit.
#ENS_AUDIT_SPLUNK_INDEX=
#ENS_AUDIT_SPLUNK_SOURCETYPE=ens:audit
# Skip TLS certificate checks. Test setups only; ReadyRoom warns at startup when this is true.
#ENS_AUDIT_SPLUNK_INSECURE=false

# Syslog (RFC 5424, octet-counted over tcp and tls). Off when ENS_AUDIT_SYSLOG_HOST is empty.
#ENS_AUDIT_SYSLOG_HOST=
# Default 514 for udp and tcp, 6514 for tls.
#ENS_AUDIT_SYSLOG_PORT=
# udp, tcp or tls. Default tcp.
#ENS_AUDIT_SYSLOG_PROTOCOL=tcp
#ENS_AUDIT_SYSLOG_FACILITY=local0

# ---------------------------------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------------------------------

# Banner shown at the top of every page, and the time zone dates are shown in.
APPLICATION_BANNERTEXT=ReadyRoom
SPRING_JACKSON_TIMEZONE=America/New_York
# Minutes of inactivity before an open session is checked out automatically.
APPLICATION_CHECKOUTAFTERMINUTES=240
# Where the "update my profile" link sends users (your directory's self-service page).
#APPLICATION_UPDATEPROFILEURL=https://selfservice.example.com/

# Logs as JSON lines (Elastic Common Schema) for a log collector, instead of plain text. The audit lines are
# raw JSON either way.
#LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
# Actuator on a port of its own (plain HTTP, not published by docker-compose.yml): Prometheus metrics at
# /actuator/prometheus and health, both readable without signing in. Unset: no metrics are exposed.
#MANAGEMENT_SERVER_PORT=9090

# JVM options. The default uses up to 75% of the container's memory limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# Application log level: info, or debug when diagnosing a problem.
LOGGING_LEVEL_COM_WINLLC_INNOUTWORK=info

# ---------------------------------------------------------------------------------------------------
# License
# ---------------------------------------------------------------------------------------------------
# The license itself, as an alternative to license/license.lic or an upload on the license
# screen: the token between the license file's BEGIN and END lines, or the whole file
# base64-encoded (base64 -w0 license.lic). It is installed at start if no license is installed
# yet, or if it is a newer revision of the installed one; otherwise the installed license is
# kept. Leave it empty to supply the license another way.
ENS_LICENSE=
