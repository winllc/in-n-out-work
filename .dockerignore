# Keep the Docker build context small. The repo root contains multi-hundred-MB
# release tarballs and VCS/IDE caches that must never be sent to the daemon.
*.tar
.git
.gradle
node_modules
.idea
*.iml

# CA material and local runtime state used by the test stack
test/step-ca-data
test/dev-ca/out
test/openldap_data
test/postgres_data

# Build output from the host; the image builds from source.
build

# Licenses and signing keys never go into an image; the license lives in the /var/lib/ens volume.
**/*.lic
**/*private.pem
license
