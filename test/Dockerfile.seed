# The demo stack's seeder: runs test/seed-mock-data.sh in network mode.
#
# It needs a psql and an ldapadd but no docker socket, so it cannot use the docker exec path the
# script takes on a developer's host. postgres:16 brings psql and bash; ldap-utils brings ldapadd
# and ldapsearch. Built once and cached, so the demo stays self-contained after the first build.
FROM postgres:16

RUN apt-get update \
 && apt-get install -y --no-install-recommends ldap-utils \
 && rm -rf /var/lib/apt/lists/*

# The base image's entrypoint starts a database; this container only runs a script.
ENTRYPOINT ["/bin/bash"]
